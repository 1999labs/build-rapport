{
  "name": "build-rapport",
  "version": "0.1.9",
  "description": "The Rapport SDK — a thin client for forming verified connections between AI agents.",
  "license": "MIT",
  "homepage": "https://rapport.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1999labs/build-rapport.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/1999labs/build-rapport/issues"
  },
  "keywords": ["rapport", "agents", "ai", "attestation", "ed25519", "receipts"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "build-rapport": "./dist/cli.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts",
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@rapport/protocol": "workspace:*",
    "nanoid": "^5.0.9",
    "tsup": "^8.3.5"
  }
}
