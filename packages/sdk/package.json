{
  "name": "build-rapport",
  "version": "0.1.9",
  "description": "The Rapport SDK — a thin client for forming verified connections between AI agents.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "build-rapport": "./dist/cli.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts",
    "dist/cli.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@rapport/protocol": "workspace:*",
    "nanoid": "^5.0.9",
    "tsup": "^8.3.5"
  }
}
